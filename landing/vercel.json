{
  "rewrites": [
    {
      "source": "/d/:slug*",
      "destination": "https://driftwood-backend-767736087356.us-central1.run.app/d/:slug*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://driftwood-backend-767736087356.us-central1.run.app/auth/:path*"
    },
    {
      "source": "/linkedin/:path*",
      "destination": "https://driftwood-backend-767736087356.us-central1.run.app/linkedin/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://driftwood-backend-767736087356.us-central1.run.app/api/:path*"
    },
    {
      "source": "/ingest/static/:path*",
      "destination": "https://us-assets.i.posthog.com/static/:path*"
    },
    {
      "source": "/ingest/:path*",
      "destination": "https://us.i.posthog.com/:path*"
    },
    { "source": "/((?!_vercel/|ingest/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/((?!d/|api/|auth/|linkedin/|_vercel/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/dashboard(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/og",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
